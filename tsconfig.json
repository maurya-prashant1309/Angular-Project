{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "sourceMap": true,
    "module": "commonjs",
    "target": "ES2020",
    "strict": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noEmitOnError": true
  },
  "exclude": [
    "node_modules"
  ]
}